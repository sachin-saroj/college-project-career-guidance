<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{resume.personalInfo.fullName}} - Resume</title>
  <style>
    body {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 20px;
      color: #333;
      line-height: 1.5;
    }
    header {
      border-bottom: 2px solid #2c3e50;
      padding-bottom: 10px;
      margin-bottom: 20px;
    }
    h1 {
      margin: 0;
      color: #2c3e50;
      font-size: 32px;
    }
    .contact-info {
      font-size: 14px;
      color: #666;
      margin-top: 5px;
    }
    h2 {
      color: #2980b9;
      font-size: 20px;
      border-bottom: 1px solid #eee;
      padding-bottom: 5px;
      margin-top: 25px;
    }
    .section-content {
      margin-top: 10px;
    }
    .item {
      margin-bottom: 15px;
    }
    .item-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .item-title {
      font-weight: bold;
      font-size: 16px;
    }
    .item-date {
      font-size: 14px;
      color: #7f8c8d;
    }
    .item-subtitle {
      font-style: italic;
      color: #555;
      margin-bottom: 5px;
    }
    ul {
      margin: 5px 0 0 0;
      padding-left: 20px;
    }
    .skills-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .skill-badge {
      background: #ecf0f1;
      padding: 4px 10px;
      border-radius: 4px;
      font-size: 14px;
      color: #2c3e50;
    }
  </style>
</head>
<body>

  <header>
    <h1>{{resume.personalInfo.fullName}}</h1>
    <div class="contact-info">
      {{resume.personalInfo.email}} | {{resume.personalInfo.phone}} | {{resume.personalInfo.location}}
      {{#if resume.personalInfo.linkedin}} | {{resume.personalInfo.linkedin}} {{/if}}
      {{#if resume.personalInfo.github}} | {{resume.personalInfo.github}} {{/if}}
    </div>
  </header>

  {{#if resume.careerObjective}}
  <section>
    <h2>Professional Summary</h2>
    <div class="section-content">
      {{resume.careerObjective}}
    </div>
  </section>
  {{/if}}

  {{#if resume.experience.length}}
  <section>
    <h2>Experience</h2>
    <div class="section-content">
      {{#each resume.experience}}
      <div class="item">
        <div class="item-header">
          <span class="item-title">{{this.role}}</span>
          <span class="item-date">{{formatDate this.startDate}} - {{formatDate this.endDate}}</span>
        </div>
        <div class="item-subtitle">{{this.company}}</div>
        <ul>
          {{#each this.description}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{#if resume.education.length}}
  <section>
    <h2>Education</h2>
    <div class="section-content">
      {{#each resume.education}}
      <div class="item">
        <div class="item-header">
          <span class="item-title">{{this.degree}}</span>
          <span class="item-date">{{this.startYear}} - {{this.endYear}}</span>
        </div>
        <div class="item-subtitle">{{this.institution}}</div>
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{#if resume.projects.length}}
  <section>
    <h2>Projects</h2>
    <div class="section-content">
      {{#each resume.projects}}
      <div class="item">
        <div class="item-title">{{this.title}}</div>
        <div class="item-subtitle">{{this.techStack}}</div>
        <p style="margin: 5px 0;">{{this.description}}</p>
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{#if resume.skills.length}}
  <section>
    <h2>Skills</h2>
    <div class="section-content skills-list">
      {{#each resume.skills}}
      <span class="skill-badge">{{this}}</span>
      {{/each}}
    </div>
  </section>
  {{/if}}

</body>
</html>
